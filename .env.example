# Copy to .env and fill in.  .env is git-ignored — never commit real credentials.

# Target application
BASE_URL=http://localhost:3000
TEST_ENV=qa

# Browser behaviour (CLI flags --browser/--headed override these)
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=10000
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
# Maximize the browser window. Headed runs only — headless keeps the fixed
# viewport above, which is what keeps layout assertions reproducible in CI.
# Read strictly from here — no fallback in code — but only *needed* for a
# headed run, since headless ignores it entirely. A --headed run maximizes by
# default; pass --no-maximize to bypass for one run. A test that sets its own
# viewport (the 360px responsive cases) wins over all of this either way.
MAXIMIZE=true

# Test accounts — use purpose-created, least-privileged QA accounts only
TEST_USERNAME=
TEST_PASSWORD=

# API testing (uncomment and wire into automation/utils/config.py when the
# first test under automation/tests/api/ needs it)
# API_BASE_URL=
# API_AUTH_TOKEN=
