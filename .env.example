# Copy to .env and fill in.  .env is git-ignored — never commit real credentials.

# Target application
BASE_URL=https://qa.fleetiq.example.com
TEST_ENV=qa

# Browser behaviour (CLI flags --browser/--headed override these)
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=30000
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Test accounts — use purpose-created, least-privileged QA accounts only
TEST_USERNAME=
TEST_PASSWORD=

# API testing (uncomment and wire into automation/utils/config.py when the
# first test under automation/tests/api/ needs it)
# API_BASE_URL=
# API_AUTH_TOKEN=
